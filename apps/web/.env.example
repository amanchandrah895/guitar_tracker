# Copy to .env for local development. Never commit .env.
# On Render, set these under the service's Environment tab instead.

# Instructor (Ohila) login password — change from the default!
ADMIN_PASSWORD=change_me_before_deploying

# ── Database: Turso (https://app.turso.tech)
# Database URL:  turso db show <db-name> --url      (starts with libsql://)
# Auth token:    turso db tokens create <db-name>   (or "Create token" in the dashboard)
# Leave both empty to use a local SQLite file in ./data (development only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Videos: Cloudinary (https://console.cloudinary.com → Settings → API Keys)
# Cloud name is shown at the top of that page (lowercase, e.g. dq3xyzabc).
# It is NOT the key's label such as "Root".
# Leave empty to store videos on local disk (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: the site's public address, used for link previews (WhatsApp etc.).
# Render fills this in automatically; set it only if you add your own domain.
# PUBLIC_URL=https://strumrr.in

# Optional: folder for clips inside Cloudinary (default: guitar-practice-logs)
# CLOUDINARY_FOLDER=guitar-practice-logs
# Optional: local data folder when not using Turso/Cloudinary
# DATA_DIR=./data
